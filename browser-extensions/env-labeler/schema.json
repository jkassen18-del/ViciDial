          },
          "ribbon": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "left",
              "right",
              "corner",
              "none"
            ],
            "description": "Ribbon position"
          },
          "faviconTint": {
            "type": "boolean",
            "description": "Tint the site favicon"
          },
          "titlePrefix": {
            "type": "boolean",
            "description": "Prefix the tab title, e.g. [PROD]"
          },
          "border": {
            "type": "boolean",
            "description": "Draw a coloured frame around the page"
          },
          "confirmForms": {
            "type": "boolean",
            "description": "Ask before submitting forms"
          },
          "enabled": {
            "type": "boolean",
            "description": "Rule is active"
          }
        }
      },
      "title": "Personal rules",
      "description": "User-editable rules (evaluated after company and remote rules). Put this under defaults to seed them."
    },
    "allowPersonalRules": {
      "type": "boolean",
      "title": "Allow personal rules",
      "description": "When false, only company and remote rules apply"
    },
    "rulesUrls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Remote rule sources",
      "description": "HTTPS URLs of JSON files ({ \"rules\": [...] }) fetched periodically"
    },
    "refreshMinutes": {
      "type": "integer",
      "title": "Refresh interval",
      "description": "Minutes between remote rule refreshes (default 60)"
    },
    "confirmDestructiveClicks": {
      "type": "boolean",
      "title": "Confirm destructive clicks",
      "description": "On rules with confirmForms, also confirm clicks on Delete/Drop/Destroy/Remove/Truncate/Purge/Deploy buttons"
    },
    "ribbonHeight": {
      "type": "integer",
      "title": "Ribbon size",
      "description": "Ribbon thickness in pixels (16-48)"
    },
    "ribbonOpacity": {
      "type": "number",
      "title": "Ribbon opacity",
      "description": "0.3 to 1"
    },
    "allowHideRibbon": {
      "type": "boolean",
      "title": "Allow hiding the ribbon",
      "description": "Show the close button that hides the ribbon for the current tab session"
    },
    "ribbonPushesContent": {
      "type": "boolean",
      "title": "Top ribbon pushes content",
      "description": "Add top padding to the page so a top ribbon does not cover it"
    },
    "showHostname": {
      "type": "boolean",
      "title": "Show host name",
      "description": "Show the host name next to the label on the ribbon"
    },
    "showBadge": {
      "type": "boolean",
      "title": "Toolbar badge",
      "description": "Show the environment tag on the toolbar icon"
    },
