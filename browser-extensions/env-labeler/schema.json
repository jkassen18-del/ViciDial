{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "description": "Master switch for all labels"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier"
          },
          "label": {
            "type": "string",
            "description": "Environment name shown on the ribbon, e.g. PRODUCTION"
          },
          "short": {
            "type": "string",
            "description": "Optional short tag for the badge and title prefix (defaults from the label, e.g. PROD)"
          },
          "color": {
            "type": "string",
            "description": "Ribbon colour as #RRGGBB"
          },
          "textColor": {
            "type": "string",
            "description": "Text colour as #RRGGBB (empty = automatic contrast)"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Host/URL patterns: host, *.host, =exact, host/path*, host:port, re:regex"
          },
          "ribbon": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "left",
              "right",
              "corner",
              "none"
            ],
            "description": "Ribbon position"
          },
          "faviconTint": {
            "type": "boolean",
            "description": "Tint the site favicon"
          },
          "titlePrefix": {
            "type": "boolean",
            "description": "Prefix the tab title, e.g. [PROD]"
          },
          "border": {
            "type": "boolean",
            "description": "Draw a coloured frame around the page"
          },
          "confirmForms": {
            "type": "boolean",
            "description": "Ask before submitting forms"
          },
          "enabled": {
            "type": "boolean",
            "description": "Rule is active"
          }
        }
      },
      "title": "Company rules",
      "description": "Environment rules from your organization. Always evaluated first and read-only for users."
    },
    "personalRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier"
          },
