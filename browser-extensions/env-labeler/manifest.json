{
  "manifest_version": 3,
  "name": "Environment Labeler",
  "short_name": "Env Labeler",
  "version": "1.0.0",
  "description": "Never confuse production with staging: coloured ribbons, tinted favicons, title prefixes, toolbar badges and production form confirmations.",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Environment Labeler" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "alarms", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/content-ui.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "storage": { "managed_schema": "schema.json" }
}
