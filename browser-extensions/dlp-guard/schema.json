{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Protection on/off for the user. Only honoured when allowUserDisable is true."
    },
    "mode": {
      "type": "string",
      "enum": [
        "all-except-trusted",
        "listed"
      ],
      "description": "\"all-except-trusted\": protect every site except trustedSites. \"listed\": only protect highRiskSites."
    },
    "trustedSites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Company / approved destinations that are never scanned. Patterns: \"acme.com\" (domain + subdomains), \"=host\", \"*.acme.com\", \"host/path*\", \"re:<regex>\"."
    },
    "highRiskSites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unapproved high-risk destinations (public AI tools, personal e-mail, file sharing). Same pattern syntax as trustedSites."
    },
    "defaultAction": {
      "type": "string",
      "enum": [
        "off",
        "log",
        "warn",
        "block"
      ],
      "description": "Action for custom rules and for any rule set to \"default\"."
    },
    "ruleActions": {
      "type": "object",
      "description": "Action per built-in detector: off | log | warn | block | default.",
