        },
        "radius": {
          "type": "integer",
          "description": "Corner radius in px."
        },
        "supportUrl": {
          "type": "string",
          "description": "Help page URL."
        },
        "supportEmail": {
          "type": "string",
          "description": "Support e-mail."
        },
        "footerText": {
          "type": "string",
          "description": "Footer text."
        }
