    "highRiskAction": {
      "type": "string",
      "enum": [
        "same",
        "warn",
        "block"
      ],
      "description": "On high-risk sites, rules at warn level are escalated to this action (\"same\" keeps them as configured)."
    },
    "requireJustification": {
      "type": "boolean",
      "description": "Require a typed business reason before \"Continue anyway\"."
    },
    "blockFileUploadsOnHighRisk": {
      "type": "string",
      "enum": [
        "off",
        "warn",
        "block"
      ],
      "description": "Warn or block every file upload to high-risk sites regardless of content."
    },
    "channels": {
      "type": "object",
      "description": "Which channels are inspected.",
      "properties": {
        "paste": {
          "type": "boolean",
          "description": "Pasted text and files."
        },
        "drop": {
          "type": "boolean",
          "description": "Drag and drop of text and files."
        },
        "upload": {
          "type": "boolean",
          "description": "File inputs (and dropped files): names and text-like file contents."
        },
        "submit": {
          "type": "boolean",
          "description": "Typed text when pressing Enter or submitting a form, on high-risk sites only."
        }
      }
    },
    "maxFileSizeMB": {
      "type": "number",
      "description": "Maximum amount of each text-like file that is scanned, in MB."
    },
    "classificationKeywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Classification markers (whole word, case-insensitive)."
    },
    "bulkEmailThreshold": {
      "type": "integer",
      "description": "Distinct e-mail addresses in one paste/upload that trigger the bulk e-mail detector."
    },
    "customRules": {
      "type": "array",
      "description": "Organization-defined regex rules.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier."
          },
          "name": {
            "type": "string",
            "description": "Name shown to users."
          },
          "description": {
            "type": "string",
            "description": "Optional explanation."
          },
          "pattern": {
            "type": "string",
            "description": "JavaScript regular expression source."
          },
          "flags": {
            "type": "string",
            "description": "Regex flags (i, m, s, u)."
          },
          "minCount": {
            "type": "integer",
            "description": "Minimum distinct matches before the rule triggers."
          },
          "action": {
            "type": "string",
            "enum": [
              "off",
              "log",
              "warn",
              "block",
              "default"
            ],
            "description": "Action when the rule triggers."
          },
          "enabled": {
            "type": "boolean",
            "description": "Rule enabled."
          }
        }
      }
    },
    "allowUserDisable": {
      "type": "boolean",
      "description": "Allow users to switch protection off from the popup."
    },
    "allowSnooze": {
      "type": "boolean",
      "description": "Allow users to pause protection on one site for snoozeMinutes."
    },
    "snoozeMinutes": {
      "type": "integer",
      "description": "Length of a snooze in minutes."
    },
    "reportingEndpoint": {
      "type": "string",
      "description": "HTTPS endpoint that receives incident batches (POST JSON). Empty disables reporting."
    },
    "reportingHeaders": {
      "type": "object",
      "description": "Extra HTTP headers for reporting, e.g. Authorization.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "department": {
      "type": "string",
      "description": "Department label sent with reports."
    },
    "includeUserEmail": {
      "type": "boolean",
      "description": "Include userEmail in reports."
    },
    "userEmail": {
      "type": "string",
      "description": "User e-mail sent with reports when includeUserEmail is true."
    },
    "brand": {
      "type": "object",
      "description": "Company brand overrides.",
      "properties": {
        "companyName": {
          "type": "string",
          "description": "Company name."
        },
        "logo": {
          "type": "string",
          "description": "Logo URL or data: URL."
        },
        "primary": {
          "type": "string",
          "description": "Primary colour (#RRGGBB)."
        },
        "accent": {
          "type": "string",
          "description": "Accent colour (#RRGGBB)."
        },
        "theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
