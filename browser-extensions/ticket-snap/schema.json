{
  "type": "object",
  "properties": {
    "provider": { "type": "string", "enum": ["webhook", "jsm", "zendesk", "freshdesk", "servicenow", "email"], "description": "Helpdesk that receives tickets." },
    "webhookUrl": { "type": "string", "description": "Webhook provider: URL that receives a JSON POST per ticket." },
    "webhookHeaders": { "type": "object", "description": "Webhook provider: extra HTTP headers, e.g. {\"Authorization\": \"Bearer ...\"}.", "additionalProperties": { "type": "string" } },
    "jsmBaseUrl": { "type": "string", "description": "Jira Service Management site URL, e.g. https://acme.atlassian.net." },
    "jsmEmail": { "type": "string", "description": "Jira Service Management account email (Basic auth)." },
    "jsmApiToken": { "type": "string", "description": "Jira Service Management API token." },
    "jsmServiceDeskId": { "type": "string", "description": "Jira Service Management service desk ID." },
    "jsmRequestTypeId": { "type": "string", "description": "Jira Service Management request type ID." },
    "jsmRaiseOnBehalf": { "type": "boolean", "description": "Raise JSM requests on behalf of the reporter email." },
    "jsmSetPriority": { "type": "boolean", "description": "Send the priority field to JSM (request type must have one)." },
    "jsmLinkTarget": { "type": "string", "enum": ["portal", "agent"], "description": "JSM ticket link: customer portal or agent view." },
    "zendeskSubdomain": { "type": "string", "description": "Zendesk subdomain (acme for acme.zendesk.com)." },
    "zendeskEmail": { "type": "string", "description": "Zendesk account email for API token auth." },
    "zendeskApiToken": { "type": "string", "description": "Zendesk API token." },
    "zendeskEndpoint": { "type": "string", "enum": ["requests", "tickets"], "description": "Create Zendesk requests (end user) or tickets (agent)." },
    "freshdeskDomain": { "type": "string", "description": "Freshdesk domain (acme for acme.freshdesk.com)." },
    "freshdeskApiKey": { "type": "string", "description": "Freshdesk API key." },
    "servicenowInstance": { "type": "string", "description": "ServiceNow instance URL, e.g. https://acme.service-now.com." },
    "servicenowAuth": { "type": "string", "enum": ["basic", "bearer"], "description": "ServiceNow authentication: basic (username/password) or bearer token." },
    "servicenowUsername": { "type": "string", "description": "ServiceNow username." },
    "servicenowPassword": { "type": "string", "description": "ServiceNow password." },
    "servicenowToken": { "type": "string", "description": "ServiceNow OAuth bearer token." },
    "servicenowSetCaller": { "type": "boolean", "description": "Set caller_id from the reporter email." },
    "servicenowAssignmentGroup": { "type": "string", "description": "Optional ServiceNow assignment group." },
    "emailTo": { "type": "string", "description": "Email provider: help desk address (defaults to brand.supportEmail)." },
    "categories": { "type": "array", "items": { "type": "string" }, "description": "Categories offered on the ticket form." },
    "defaultCategory": { "type": "string", "description": "Pre-selected category." },
    "defaultPriority": { "type": "string", "enum": ["low", "normal", "high", "urgent"], "description": "Pre-selected priority." },
    "requiredFields": { "type": "array", "items": { "type": "string", "enum": ["description", "category", "reporterName", "reporterEmail"] }, "description": "Form fields that must be filled in (summary is always required)." },
    "summaryPrefix": { "type": "string", "description": "Text prepended to every ticket summary." },
    "descriptionTemplate": { "type": "string", "description": "Description hint / template." },
    "descriptionPrefill": { "type": "boolean", "description": "Start the description with the template text." },
    "reporterName": { "type": "string", "description": "Default reporter name." },
    "reporterEmail": { "type": "string", "description": "Default reporter email." },
    "includeScreenshotDefault": { "type": "boolean", "description": "Tick \"Include screenshot\" by default." },
    "diagnostics": {
      "type": "object",
      "description": "Which diagnostics are attached (false = never collected).",
      "properties": {
        "url": { "type": "boolean", "description": "Page URL." },
        "title": { "type": "boolean", "description": "Page title." },
        "browser": { "type": "boolean", "description": "Browser and version." },
        "os": { "type": "boolean", "description": "Operating system and version." },
        "arch": { "type": "boolean", "description": "CPU architecture." },
        "language": { "type": "boolean", "description": "Browser language." },
        "timeZone": { "type": "boolean", "description": "Time zone." },
        "screen": { "type": "boolean", "description": "Screen resolution." },
        "viewport": { "type": "boolean", "description": "Viewport size." },
        "zoom": { "type": "boolean", "description": "Page zoom." },
        "capturedAt": { "type": "boolean", "description": "Capture timestamp." },
        "extensionVersion": { "type": "boolean", "description": "Ticket Snap version." },
        "userAgent": { "type": "boolean", "description": "Raw user-agent string." }
      }
    },
    "allowRemoveUrl": { "type": "boolean", "description": "Let users untick \"Include page address\"." },
    "showContextMenu": { "type": "boolean", "description": "Show the right-click \"Report a problem with this page\" item." },
    "keepHistory": { "type": "boolean", "description": "Keep a local history of submitted tickets." },
    "defaults": {
      "type": "object",
      "description": "Suggested values (same keys as above) that users may change.",
      "properties": {
        "provider": { "type": "string" },
        "webhookUrl": { "type": "string" },
        "webhookHeaders": { "type": "object", "additionalProperties": { "type": "string" } },
        "jsmBaseUrl": { "type": "string" }, "jsmEmail": { "type": "string" }, "jsmApiToken": { "type": "string" },
        "jsmServiceDeskId": { "type": "string" }, "jsmRequestTypeId": { "type": "string" },
        "jsmRaiseOnBehalf": { "type": "boolean" }, "jsmSetPriority": { "type": "boolean" }, "jsmLinkTarget": { "type": "string" },
        "zendeskSubdomain": { "type": "string" }, "zendeskEmail": { "type": "string" }, "zendeskApiToken": { "type": "string" }, "zendeskEndpoint": { "type": "string" },
        "freshdeskDomain": { "type": "string" }, "freshdeskApiKey": { "type": "string" },
        "servicenowInstance": { "type": "string" }, "servicenowAuth": { "type": "string" }, "servicenowUsername": { "type": "string" },
        "servicenowPassword": { "type": "string" }, "servicenowToken": { "type": "string" }, "servicenowSetCaller": { "type": "boolean" }, "servicenowAssignmentGroup": { "type": "string" },
        "emailTo": { "type": "string" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "defaultCategory": { "type": "string" }, "defaultPriority": { "type": "string" },
        "requiredFields": { "type": "array", "items": { "type": "string" } },
        "summaryPrefix": { "type": "string" }, "descriptionTemplate": { "type": "string" }, "descriptionPrefill": { "type": "boolean" },
        "reporterName": { "type": "string" }, "reporterEmail": { "type": "string" }, "includeScreenshotDefault": { "type": "boolean" },
        "diagnostics": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "allowRemoveUrl": { "type": "boolean" }, "showContextMenu": { "type": "boolean" }, "keepHistory": { "type": "boolean" }
      }
    },
    "brand": {
      "type": "object",
      "description": "Company branding.",
      "properties": {
        "companyName": { "type": "string", "description": "Company name." },
        "logo": { "type": "string", "description": "Logo URL or data: URL." },
        "primary": { "type": "string", "description": "Primary colour (#RRGGBB)." },
        "accent": { "type": "string", "description": "Accent colour (#RRGGBB)." },
        "theme": { "type": "string", "enum": ["auto", "light", "dark"], "description": "Colour theme." },
        "radius": { "type": "integer", "description": "Corner radius in px (0-24)." },
        "supportUrl": { "type": "string", "description": "Help page URL." },
        "supportEmail": { "type": "string", "description": "Support email (also the Email provider default)." },
        "footerText": { "type": "string", "description": "Footer text." }
      }
    }
  }
}
